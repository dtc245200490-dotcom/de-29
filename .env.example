# Copy this file to .env and replace every password with a strong unique value.
MYSQL_ROOT_PASSWORD=replace_with_long_random_root_password
MYSQL_DATABASE=recipe_db
MYSQL_USER=recipe_user
MYSQL_PASSWORD=replace_with_long_random_app_password
# Generate with: docker run --rm php:8.3-cli-alpine php -r "echo password_hash('YOUR_ADMIN_PASSWORD', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=replace_with_php_password_hash
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_long_random_grafana_password
